<Application x:Class="Thanslator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ================= 品牌色板（brand-guidelines v1.0） ================= -->
        <SolidColorBrush x:Key="InkBrush" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE8EAF0" />
        <SolidColorBrush x:Key="TextStrongBrush" Color="#FFF2F3F7" />
        <SolidColorBrush x:Key="TextSoftBrush" Color="#FFC5C9D8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FFB3B9CA" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#FF8B91A4" />
        <SolidColorBrush x:Key="IconGlyphBrush" Color="#FF8B90A5" />
        <SolidColorBrush x:Key="BrandBlueBrush" Color="#FF6B8CFF" />
        <SolidColorBrush x:Key="PopperBorderBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="SegBackgroundBrush" Color="#4D000000" />
        <SolidColorBrush x:Key="SegBorderBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="TrackOffBrush" Color="#3A3A44" />
        <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#2A2A32" />

        <!-- 统一字体：拉丁用 Segoe UI，中文回退到系统自带的微软雅黑（Microsoft YaHei UI）。
             显式给出回退链，避免 WPF 逐字形回退到宋体等衬线字体导致字重/字宽不一致。 -->
        <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

        <!-- 旧键名保留，供设置窗口等沿用，避免一次性大改 -->
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA0B5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B8CFF" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F01A1C26" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#14FFFFFF" />

        <!-- 卡片：180deg #282A36(92%) → #1A1C26(94%) -->
        <LinearGradientBrush x:Key="PopperBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#EB282A36" Offset="0" />
            <GradientStop Color="#F01A1C26" Offset="1" />
        </LinearGradientBrush>

        <!-- 品牌渐变 135deg #4F7CFF → #6B8CFF（开关/按钮） -->
        <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4F7CFF" Offset="0" />
            <GradientStop Color="#FF6B8CFF" Offset="1" />
        </LinearGradientBrush>

        <!-- 强调渐变 135deg #6B8CFF → #9B6BFF（Logo/徽标） -->
        <LinearGradientBrush x:Key="BrandAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B8CFF" Offset="0" />
            <GradientStop Color="#FF9B6BFF" Offset="1" />
        </LinearGradientBrush>

        <!-- 分段控件选中态：白 13% → 白 6% -->
        <LinearGradientBrush x:Key="SegActiveBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#21FFFFFF" Offset="0" />
            <GradientStop Color="#0FFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ================= 图标按钮 22×22 ================= -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource IconGlyphBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconFill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconFill" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconFill" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= 分段控件项 ================= -->
        <Style x:Key="SegItem" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SegFill" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock x:Name="SegText"
                                       Margin="0,2.5"
                                       Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegFill" Property="Background" Value="{StaticResource SegActiveBrush}" />
                                <Setter TargetName="SegText" Property="Foreground" Value="#FFFFFFFF" />
                                <Setter TargetName="SegFill" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegFill" Property="Background" Value="#0AFFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegItemSmall" TargetType="ToggleButton" BasedOn="{StaticResource SegItem}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SegFill" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock x:Name="SegText"
                                       Margin="0,2"
                                       Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegFill" Property="Background" Value="{StaticResource SegActiveBrush}" />
                                <Setter TargetName="SegText" Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegFill" Property="Background" Value="#0AFFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 总开关 32×16 ================= -->
        <Style x:Key="PowerToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="8" Background="{StaticResource TrackOffBrush}">
                            <Ellipse x:Name="Thumb"
                                     Width="12"
                                     Height="12"
                                     Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandGradientBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" Color="#FF4F7CFF" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 小开关 28×15 ================= -->
        <Style x:Key="SmallToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="8" Background="{StaticResource TrackOffBrush}">
                            <Ellipse x:Name="Thumb"
                                     Width="11"
                                     Height="11"
                                     Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandGradientBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 兼容旧引用 -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton" BasedOn="{StaticResource PowerToggle}" />

        <!-- ================= 关闭按钮 ================= -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource IconGlyphBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseFill" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseFill" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= 设置窗口按钮 ================= -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnFill" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnFill" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1F2028"
                                BorderBrush="{StaticResource PopperBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单：与深色卡片一致，避免默认浅色模板的刺眼高亮 -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="10,5"
                                Margin="2,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
