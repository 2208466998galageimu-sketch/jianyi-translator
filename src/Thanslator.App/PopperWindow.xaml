<Window x:Class="Thanslator.App.PopperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="简译"
        Icon="Assets/app.ico"
        Width="310"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Grid x:Name="RootGrid" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>

        <!-- 右键菜单：托盘图标被折叠/找不到时的兜底出口 -->
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource DarkContextMenu}"
                         Placement="MousePoint">
                <MenuItem Header="显示控制条" Style="{StaticResource DarkMenuItem}" Click="ShowMenuItem_Click" />
                <MenuItem Header="隐藏到系统托盘" Style="{StaticResource DarkMenuItem}" Click="HideMenuItem_Click" />
                <MenuItem Header="模型配置…" Style="{StaticResource DarkMenuItem}" Click="LocalMtMenuItem_Click" />
                <MenuItem x:Name="ClipboardFallbackMenuItem"
                          Header="剪贴板取词（兼容 PDF/浏览器）"
                          Style="{StaticResource DarkMenuItem}"
                          IsCheckable="True"
                          ToolTip="通过 Ctrl+C 读取选区；会短暂使用剪贴板并尽力恢复原内容"
                          Click="ClipboardFallbackMenuItem_Click" />
                <Separator Style="{StaticResource DarkMenuSeparator}" />
                <MenuItem Header="退出简译" Style="{StaticResource DarkMenuItem}" Click="QuitMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Border x:Name="ExpandedPanel"
                Background="{StaticResource PopperBackgroundBrush}"
                BorderBrush="{StaticResource PopperBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,7,12,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行：品牌 + 抽屉/隐藏 + 总开关 -->
                <Grid Grid.Row="0" Height="22" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="20"
                           Height="20"
                           Source="Assets/app.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               x:Name="PageTitle"
                               Text="简译"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextStrongBrush}"
                               VerticalAlignment="Center" />

                    <Button x:Name="DockButton"
                            Grid.Column="3"
                            Style="{StaticResource IconButton}"
                            ToolTip="收向侧边（自动吸附最近边缘）"
                            Click="DockButton_Click">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Data="M5.5,4 H11.5 A1.5,1.5 0 0 1 13,5.5 V18.5 A1.5,1.5 0 0 1 11.5,20 H5.5 A1.5,1.5 0 0 1 4,18.5 V5.5 A1.5,1.5 0 0 1 5.5,4 Z M8.5,8 V16 M13,12 H18 M15.5,9 L18.5,12 L15.5,15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>

                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            Margin="2,0,0,0"
                            Style="{StaticResource IconButton}"
                            AutomationProperties.Name="设置"
                            ToolTip="设置"
                            Click="SettingsButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE713;" />
                    </Button>

                    <Button x:Name="HideButton"
                            Grid.Column="4"
                            Margin="2,0,0,0"
                            Style="{StaticResource IconButton}"
                            ToolTip="隐藏到托盘"
                            Click="HideButton_Click">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Data="M5,12 H19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>

                    <ToggleButton x:Name="EnabledToggle"
                                  Grid.Column="5"
                                  Margin="6,0,0,0"
                                  Style="{StaticResource PowerToggle}"
                                  VerticalAlignment="Center"
                                  ToolTip="启用/停用划词翻译"
                                  Checked="EnabledToggle_Changed"
                                  Unchecked="EnabledToggle_Changed" />

                    <Button Grid.Column="6"
                            Margin="2,0,0,0"
                            Style="{StaticResource CloseButton}"
                            Content="×"
                            VerticalAlignment="Center"
                            ToolTip="退出简译"
                            Click="QuitButton_Click" />
                </Grid>

                <Grid x:Name="HomePage" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="3" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TranslationLanguageButton" Margin="0,0,3,0" Padding="6,0"
                                    Style="{StaticResource GhostButton}" FontSize="11" Click="TranslationLanguage_Click">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="▾" Margin="4,0,0,0" />
                                    <TextBlock x:Name="TranslationLanguageLabel" Text="翻译语言" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="TranslationEngineButton" Grid.Column="1" Margin="3,0,0,0" Padding="6,0"
                                    Style="{StaticResource GhostButton}" FontSize="11" Click="TranslationEngine_Click">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="▾" Margin="4,0,0,0" />
                                    <TextBlock x:Name="TranslationEngineLabel" Text="翻译引擎" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Popup x:Name="TranslationLanguagePopup" PlacementTarget="{Binding ElementName=TranslationLanguageButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#1F2028" BorderBrush="{StaticResource PopperBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Width="248" PreviewKeyDown="TranslationLanguage_KeyDown">
                                    <StackPanel>
                                        <TextBlock Text="原文语言" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <ComboBox x:Name="TranslationSourcePicker" Margin="0,4,0,8" MinHeight="26"
                                                  AutomationProperties.Name="原文语言" DisplayMemberPath="Name" SelectedValuePath="Code"
                                                  SelectionChanged="TranslationSource_Changed" />
                                        <TextBlock Text="译文语言" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <ComboBox x:Name="TranslationTargetPicker" Margin="0,4,0,8" MinHeight="26"
                                                  AutomationProperties.Name="译文语言" DisplayMemberPath="Name" SelectedValuePath="Code" />
                                        <TextBlock x:Name="TranslationLanguageFeedback" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Visibility="Collapsed" />
                                        <Button x:Name="TranslationLanguageApply" Content="应用" Style="{StaticResource PrimaryButton}"
                                                Margin="0,8,0,0" Click="ApplyTranslationLanguage_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ComboBox x:Name="KnowledgeComboPicker" Visibility="Collapsed" Margin="0,5,0,0" FontSize="11" SelectionChanged="KnowledgeCombo_Changed"
                                  AutomationProperties.Name="当前知识库组合" />
                    </StackPanel>
                    <!-- 第二行：翻译模式 -->
                    <Border Grid.Row="0"
                            Margin="0,5,0,0"
                            Background="{StaticResource SegBackgroundBrush}"
                            BorderBrush="{StaticResource SegBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ModeFluentItem"
                                          Grid.Column="0"
                                          Style="{StaticResource SegItem}"
                                          Content="通序翻译"
                                          Click="ModeItem_Click" />
                            <ToggleButton x:Name="ModeLiteralItem"
                                          Grid.Column="1"
                                          Style="{StaticResource SegItem}"
                                          Content="锁序直译"
                                          Click="ModeItem_Click" />
                        </Grid>
                    </Border>

                    <!-- 第三行：短语拆分（仅锁序直译时出现） -->
                    <Grid x:Name="PhrasePanel" Grid.Row="1" Margin="2,4,2,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="4"
                                     Height="4"
                                     Margin="0,0,5,0"
                                     Fill="{StaticResource BrandBlueBrush}"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#FF6B8CFF" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="短语拆分"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSoftBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton x:Name="PhraseToggle"
                                      Style="{StaticResource SmallToggle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      ToolTip="短语拆分开关"
                                      Checked="PhraseToggle_Changed"
                                      Unchecked="PhraseToggle_Changed" />
                    </Grid>

                    <!-- 第四行：呈现方式 -->
                    <Grid Grid.Row="2" Margin="2,2,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="呈现方式"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource SegBackgroundBrush}"
                                BorderBrush="{StaticResource SegBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="SurfaceTooltipItem"
                                              Grid.Column="0"
                                              Style="{StaticResource SegItemSmall}"
                                              Content="悬注"
                                              ToolTip="悬注：只读、点击穿透的小气泡"
                                              Click="SurfaceItem_Click" />
                                <ToggleButton x:Name="SurfacePanelItem"
                                              Grid.Column="1"
                                              Style="{StaticResource SegItemSmall}"
                                              Content="常驻"
                                              ToolTip="常驻：可交互、默认不自动关闭"
                                              Click="SurfaceItem_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Visibility="Collapsed" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsPage" Margin="0,8,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自动识图（OCR）" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextStrongBrush}" />
                        <ToggleButton x:Name="OcrToggle" Grid.Column="1"
                                      Style="{StaticResource PowerToggle}"
                                      AutomationProperties.Name="自动识图（OCR）"
                                      ToolTip="自动识图（OCR）"
                                      Click="OcrToggle_Click" />
                    </Grid>
                    <Button Content="更多设置" Style="{StaticResource GhostButton}" Click="MoreSettings_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>

                </ScrollViewer>

                <!-- 第五行：状态提示 -->
                <Grid Grid.Row="2" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Margin="5,3,0,0" FontSize="10"
                            Content="框选翻译" Style="{StaticResource GhostButton}"
                            Click="RegionOcrButton_Click" />
                    <Border Grid.ColumnSpan="2" Height="1" Background="{StaticResource DividerBrush}" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,3,0,0"
                               FontSize="9.5"
                               Foreground="{StaticResource TextDimBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Text="选中文本后悬停" />
                </Grid>
            </Grid>
        </Border>

        <!-- 贴边收起的抽屉把手 -->
        <Border x:Name="HandlePanel"
                Visibility="Collapsed"
                Background="{StaticResource PopperBackgroundBrush}"
                BorderBrush="{StaticResource PopperBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Button x:Name="HandleButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="展开简译控制条"
                    Click="HandleButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="12">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="12" Height="12" Source="Assets/app.png"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="⋮"
                                           FontSize="16"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>
